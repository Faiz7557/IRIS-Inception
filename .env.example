# AI services (backend)
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=

# Speech services (backend)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
TTS_VOICE=
TTS_FALLBACK_VOICE=

# Supabase: database, auth, public client config
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Application secrets (backend)
PROFILE_ENC_KEY_V1=
WS_TICKET_SECRET=
CONSOLE_PASSCODE=
CONSOLE_JWT_SECRET=

# Public URLs the API hands out (contact share link, call WebSocket base, CORS allow-list)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Runtime environment: dev|test|prod (default prod when unset). The two flags below only work in dev/test;
# the API refuses to start if either is set while J112_ENV is prod.
J112_ENV=
# Dev/smoke only, never in prod: fake STT/LLM/TTS/geocode (no network) and an auth bypass user id
J112_FAKE_PROVIDERS=
J112_DEV_USER=

# Web push (VAPID keys; public key is also used by web)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Frontend and API endpoints (web)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Reverse geocoding (backend)
NOMINATIM_USER_AGENT=

# Supabase CLI: placeholder SMS provider token (test OTP numbers only)
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Web (browser-exposed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

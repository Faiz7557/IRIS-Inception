# Runtime environment: dev|test|prod (default prod when unset)
J112_ENV=dev

# Dev/smoke only (jangan gunakan di prod): fake STT/LLM/TTS/geocode & auth bypass
J112_FAKE_PROVIDERS=1
J112_DEV_USER=d3ed3ed1-3c3e-4122-a8ee-e4217d9f58c5
# Dev mode: putar ulang respons LLM dari rekaman JSON demo tanpa panggil API
# J112_LLM_REPLAY=demo-video/capture/llm-replay.json

# LLM Relay (Penyederhana ucapan operator 112 -> kartu pertanyaan bertombol)
# Opsi 1: 9router / OpenAI-compatible endpoint (misal Gemini 3.8 Flash)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=ag/gemini-3.8-flash-low
LLM_TIMEOUT_S=6.0

# Opsi 2: Anthropic API langsung (Claude 3.5 Haiku)
ANTHROPIC_API_KEY=

# Speech-to-Text (STT) - Suara operator 112 -> teks real-time
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Text-to-Speech (TTS) - Jawaban pengguna -> suara sintesis ke operator
# ElevenLabs sebagai TTS utama jika key terisi; Google Cloud TTS sebagai cadangan
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=GdyFAZdMpKMBHw5pc1Bu
ELEVENLABS_MODEL=eleven_flash_v2_5
GOOGLE_APPLICATION_CREDENTIALS_JSON=
TTS_VOICE=
TTS_FALLBACK_VOICE=
# Dev only: aktifkan TTS asli meskipun J112_FAKE_PROVIDERS=1
J112_REAL_TTS=1

# Supabase (Database, Auth, Client)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Kriptografi & rahasia internal aplikasi (backend)
PROFILE_ENC_KEY_V1=
WS_TICKET_SECRET=
CONSOLE_PASSCODE=iris112
CONSOLE_JWT_SECRET=

# Public URLs & CORS
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Frontend Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reverse geocoding (backend)
NOMINATIM_USER_AGENT=Jembatan112/1.0

# Web Push Notifications (opsional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
